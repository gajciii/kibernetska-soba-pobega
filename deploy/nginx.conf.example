# Primer za že potrjeno domeno in že izdano TLS potrdilo.
# Luka mora urediti DNS, potrdilo, poti in omogočenje tega virtualnega gostitelja.
server {
    listen 80;
    server_name escaperoom.feri.um.si;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name escaperoom.feri.um.si;
    ssl_certificate /etc/letsencrypt/live/escaperoom.feri.um.si/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/escaperoom.feri.um.si/privkey.pem;
    client_max_body_size 32k;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
