# Lokalni razvoj: npm run dev (vmesnik 5173, API 3000).
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://operacija404@127.0.0.1:55432/operacija404
COOKIE_SECURE=false
TRUST_PROXY=0
SESSION_TTL_DAYS=180

# Produkcija: vrednosti shrani v /srv/operacija404/shared/.env, ne v Git.
# NODE_ENV=production
# HOST=127.0.0.1
# PORT=3000
# APP_ORIGIN=https://escaperoom.feri.um.si
# DATABASE_URL=postgresql://operacija404:NASTAVI_GESLO@127.0.0.1:5432/operacija404
# COOKIE_SECURE=true
# TRUST_PROXY=1
# Dogovorjeni javni naslov je escaperoom.feri.um.si; pred objavo uredi DNS in HTTPS.
# Če pg_dump ni v PATH, nastavi absolutno pot do ustrezne različice:
# PG_DUMP_BIN=/usr/bin/pg_dump
