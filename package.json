{
  "name": "operacija-404",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kibernetska soba pobega za srednješolce",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,vmesnik \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:edge": "playwright test --project=edge-namizje --project=edge-ozek-zaslon",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:init": "node --env-file-if-exists=.env dist/server/db-cli.js init",
    "db:backup": "node --env-file-if-exists=.env dist/server/db-cli.js backup",
    "db:local": "node scripts/db-local.mjs",
    "db:local:stop": "node scripts/db-local.mjs stop",
    "check:client": "node scripts/check-client.mjs"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/supertest": "7.2.1",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
