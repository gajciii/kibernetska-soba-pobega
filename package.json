{
  "name": "operacija-404",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Kibernetska soba pobega",
  "author": "Gaja Gujt",
  "license": "MIT",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n api,vmesnik \"tsx watch --env-file-if-exists=.env server/index.ts\" \"vite\"",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/server/index.js",
    "db:init": "node --env-file-if-exists=.env dist/server/db-cli.js init",
    "db:backup": "node --env-file-if-exists=.env dist/server/db-cli.js backup",
    "db:local": "node scripts/db-local.mjs",
    "db:local:stop": "node scripts/db-local.mjs stop"
  },
  "dependencies": {
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "concurrently": "10.0.7",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.8"
  }
}
